DATABASE_URL=postgres://username:password@localhost:5432/academic_task_db?sslmode=disable
PORT=5000

# 前端網址（驗證信連結會指向此網址）
FRONTEND_URL=http://localhost:5173

# 寄驗證信：二選一即可。雲端部署（如 Render）建議用 Resend，本機可用 Gmail SMTP。
# 設定步驟請看：docs/SMTP與Twilio設定教學.md 與 docs/Resend寄信設定.md

# Resend（建議用於雲端，免費額度約 3000 封/月）
RESEND_API_KEY=re_xxxxxxxxxxxx

# Gmail SMTP（本機開發用；雲端可能連線逾時）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=你的Gmail@gmail.com
# SMTP_PASS=Gmail應用程式密碼_16碼
MAIL_FROM=AcadeBee <onboarding@resend.dev>
