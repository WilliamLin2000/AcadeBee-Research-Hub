DATABASE_URL=postgres://username:password@localhost:5432/academic_task_db?sslmode=disable
PORT=5000

# 前端網址（驗證信連結會指向此網址）
FRONTEND_URL=http://localhost:5173

# 寄驗證信用 SMTP（不設定則不寄信，開發時驗證碼會印在後端 log）
# 設定步驟請看：docs/SMTP與Twilio設定教學.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=你的Gmail@gmail.com
SMTP_PASS=Gmail應用程式密碼_16碼
MAIL_FROM=AcadeBee <你的Gmail@gmail.com>
